# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored —
# never commit real token or key values.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Passive hardware-diagnostic collector (maintenance-gateway sidecar)
# ---------------------------------------------------------------------------

# Trusted-LAN port the wall tablet posts to. The container always listens on
# 8787 internally; this is the published host port.
#   tablet endpoint -> http://<docker-host-LAN-IP>:<this port>/ingest
EZONE_MAINTENANCE_PORT=3081

# Shared secret for POST /ingest. The Passive Tap APK sends it as
# "Authorization: Bearer <token>"; without it the collector answers 401, and
# if it is unset the collector refuses all ingest with 503.
# Generate a fresh one (do not reuse an example):
#   openssl rand -hex 32
EZONE_COLLECTOR_TOKEN=

# Optional broadcast decoder key, base64, recovered from a locally supplied
# AAService APK. Leave blank to store captures encrypted and undecoded — the
# collector still journals every record, it just cannot name the frames.
#   blank  -> capture-only  ("decoderConfigured": false on /health)
#   set    -> frames decoded into /data/frame-<date>.ndjson
EZONE_BROADCAST_KEY_BASE64=

# ---------------------------------------------------------------------------
# Endpoint surface (for reference — nothing to configure here)
# ---------------------------------------------------------------------------
# POST /ingest    bearer-token required. The only tablet-facing route.
# GET  /health    unauthenticated liveness: token/decoder configured, last ingest.
# GET  /summary   unauthenticated read-only capture statistics.
#
# /health and /summary have no auth, so keep the published port on the trusted
# LAN only: do not port-forward it, and do not route it through Traefik without
# the RFC1918 ipallowlist middleware. The app container reaches /summary over
# the internal compose network at http://maintenance-gateway:8787 — that path
# is never published.

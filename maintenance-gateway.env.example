# Secrets for the maintenance-gateway sidecar. This file's REAL copy lives on
# the Docker HOST, never in git — the compose file loads it (optionally) from:
#
#   ./.env.maintenance                    beside the compose file, or
#   /srv/ezone/maintenance-gateway.env    fixed host path, survives git-synced
#                                         redeploys (recommended for Dockhand)
#
# Set it up once on the host:
#   sudo mkdir -p /srv/ezone
#   sudo cp maintenance-gateway.env.example /srv/ezone/maintenance-gateway.env
#   sudo chmod 600 /srv/ezone/maintenance-gateway.env
#   # then edit in the real values
#
# Without this file the collector still runs, but answers 503 on /ingest and
# reports "collectorTokenConfigured": false on /health — nothing is received
# until the token exists. After creating or changing the file, recreate the
# container (docker compose up -d) so it re-reads the values.

# Shared secret for POST /ingest. The Passive Tap APK sends it as
# "Authorization: Bearer <token>". Any string works; 16 hex characters is the
# sweet spot — short enough to type on the wall tablet, and at 64 bits still
# unguessable from the LAN (the collector has no rate limiting, so avoid
# anything shorter than ~12 characters):
#   openssl rand -hex 8
EZONE_COLLECTOR_TOKEN=

# Optional broadcast decoder key, base64, recovered from a locally supplied
# AAService APK. Blank is safe: captures are journaled encrypted, undecoded.
EZONE_BROADCAST_KEY_BASE64=
